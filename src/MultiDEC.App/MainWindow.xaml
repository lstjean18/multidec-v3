<Window x:Class="MultiDEC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiDEC.App.ViewModels"
        xmlns:app="clr-namespace:MultiDEC.App"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="MultiDEC v3" Height="900" Width="1500" Icon="MultiDEC.ico"
        WindowState="Maximized" FontFamily="Segoe UI" FontSize="13">
  <Window.DataContext>
    <vm:FacadeViewModel />
  </Window.DataContext>

  <!--
    Disposition validée par Laurent le 24/11/2026 (maquette « Interface MultiDEC v3 – proposition ») :
    ruban en haut ; à gauche les onglets Général puis une face par onglet (S1…S4) ; au centre le dessin 3D ;
    en bas, sur toute la largeur, les grilles de la face active, le décompte, les amarrages et les alertes.
  -->
  <Window.Resources>
    <app:ConvertisseurLibelle x:Key="Libelle" />
    <app:ConvertisseurEgal x:Key="Egal" />
    <BooleanToVisibilityConverter x:Key="VisibleSi" />
    <app:ConvertisseurCoteOptionnelle x:Key="CoteOptionnelle" />
    <app:ConvertisseurHauteurMax x:Key="HauteurMax" />
    <app:ConvertisseurPositifEnBooleen x:Key="PositifEnBooleen" />
    <app:ConvertisseurLongueursSelonType x:Key="LongueursSelonType" />
    <SolidColorBrush x:Key="Bordure" Color="#D5D9E0" />
    <SolidColorBrush x:Key="Discret" Color="#57606A" />
    <SolidColorBrush x:Key="Accent" Color="#1F5FA8" />

    <DataTemplate x:Key="ModeleLibelle">
      <TextBlock Text="{app:Liaison Converter={StaticResource Libelle}}" />
    </DataTemplate>

    <Style x:Key="ListeLibelles" TargetType="ComboBox">
      <Setter Property="ItemTemplate" Value="{StaticResource ModeleLibelle}" />
    </Style>

    <!-- Bouton du ruban : pictogramme au-dessus du libellé. -->
    <Style x:Key="BoutonRuban" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style x:Key="Picto" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style x:Key="TitreGroupe" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Discret}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="GroupeRuban" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- Titres de section des panneaux (« DIMENSIONS », « DIAGONALES »…). -->
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Discret}" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="Etiquette" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,8,3" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3" />
    </Style>

    <!-- « Valider la structure » : vert quand la face est à jour, rouge dès qu'un paramètre demande de la revalider. -->
    <Style x:Key="BoutonValider" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fond" Background="#2E7D32" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{app:Liaison FaceActiveAValider}" Value="True">
                <Setter TargetName="Fond" Property="Background" Value="#C62828" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fond" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton de forme (Droite, En L, En U, Fermée). -->
    <Style x:Key="BoutonForme" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Cadre" BorderBrush="#C3C9D1" BorderThickness="1" CornerRadius="6" Background="White" Padding="4" Margin="2">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Cadre" Property="Background" Value="#E8F0FA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Panneau d'une face (S1…S4) : DataContext = l'écran, paramètres de la face active. -->
    <DataTemplate x:Key="PanneauFace">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,0,10,10">
          <TextBlock Style="{StaticResource Section}" Text="DIMENSIONS" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Etiquette}" Text="Longueur souhaitée (m)" />
            <TextBox Grid.Column="1" Margin="0,2" Text="{app:Liaison LongueurFacade, StringFormat=0.00}" />
            <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Largeur de maille (m)" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{app:Liaison LargeursProposees}" SelectedItem="{app:Liaison LargeurMaille}" ItemStringFormat="0.00" />
            <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Maille préférée (m)" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{app:Liaison ChoixLongueursMaille}" SelectedItem="{app:Liaison LongueurMaillePreferee}" ItemStringFormat="0.00" />
            <TextBlock Grid.Row="3" Style="{StaticResource Etiquette}" Text="Nombre d'accès" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{app:Liaison NombreAcces}" />
            <TextBlock Grid.Row="4" Style="{StaticResource Etiquette}" Text="Dernier plancher (m)" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Text="{app:Liaison HauteurDernierPlancher, StringFormat=0.00}" />
            <TextBlock Grid.Row="5" Style="{StaticResource Etiquette}" Text="Distance à la façade (m)" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" Text="{app:Liaison Parametres.DistanceFacade, StringFormat=0.00}" />
          </Grid>
          <TextBlock Text="Le nombre d'accès est recalculé quand la longueur change, puis modifiable." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Discret}" Margin="0,4" />
          <Border Background="#F3F4F6" CornerRadius="6" Padding="8" Margin="0,4">
            <TextBlock Text="{app:Liaison ResumeFace}" TextWrapping="Wrap" FontSize="12" />
          </Border>
          <UniformGrid Columns="2" Margin="0,6,0,0">
            <Button Content="Valider la structure" Command="{app:Liaison Proposer}" Padding="6" Margin="0,0,4,0" Style="{StaticResource BoutonValider}"
                    ToolTip="Recalcule les grilles de cette face depuis les dimensions (rouge : un paramètre a changé, à valider)" />
            <Button Content="Copier depuis S1" Command="{app:Liaison CopierS1}" IsEnabled="{app:Liaison PeutCopierS1}" Padding="6" Margin="4,0,0,0"
                    ToolTip="Reprend les paramètres et les grilles de S1 (le carré d'angle est conservé)" />
          </UniformGrid>

          <TextBlock Style="{StaticResource Section}" Text="DIAGONALES" />
          <CheckBox Content="Diagonales 1 maille sur 2" IsChecked="{app:Liaison Parametres.DiagonalesRenforcees}" />
          <CheckBox Content="Diagonale dans la 1re maille" IsChecked="{app:Liaison Parametres.DiagonalePremiereMaille}" />
          <Button Content="Recocher les cases Diago" Command="{app:Liaison ProposerLesDiagonales}" HorizontalAlignment="Left" Padding="10,4" Margin="0,6,0,0"
                  ToolTip="Recoche les cases « Diago » de la grille des mailles : une maille sur 5, ou sur 2 avec l'option" />
          <TextBlock Text="Par défaut une maille sur 5, sens alterné automatiquement." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Discret}" Margin="0,4" />

          <TextBlock Style="{StaticResource Section}" Text="ACCÈS" />
          <CheckBox Content="Trappes et plateaux acier" IsChecked="{app:Liaison TrappesAcier}"
                    ToolTip="Mailles d'accès de 2 m et plus : trappe de 1,00 m + traverse intermédiaire + plateaux" />
          <CheckBox Content="Lisse GC accès 1,50 m au niveau 0" IsChecked="{app:Liaison Parametres.LisseGcAccesNiveau0}"
                    ToolTip="Lisse à 1,50 m au pied des échelles, du côté où il y a un garde-corps" />
          <TextBlock Text="Trappes acier : les garde-corps MDS de la face passent en lisses (règle v2)." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Discret}" Margin="0,4" />

          <TextBlock Style="{StaticResource Section}" Text="OPTIONS" />
          <DockPanel Margin="0,2,0,4">
            <ComboBox DockPanel.Dock="Right" Width="110" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixTraverses}" SelectedItem="{app:Liaison Parametres.Traverses}"
                      ToolTip="Traverses des files aux planchers complets ; poutrelle et poutre au-delà de 1,05 m de largeur" />
            <TextBlock Style="{StaticResource Etiquette}" Text="Traverses" />
          </DockPanel>
          <CheckBox Content="Lisses en pied" IsChecked="{app:Liaison Parametres.LissesEnPied}" />
          <CheckBox Content="Départ poteaux 3 m côté extérieur" IsChecked="{app:Liaison Parametres.Depart3mExterieur}" />
          <CheckBox Content="Garde-corps 1,50 m au dernier niveau" IsChecked="{app:Liaison Parametres.GardeCorpsCouvreur}" />
          <CheckBox Content="Grutable (accessoires de levage)" IsChecked="{app:Liaison Parametres.Grutable}"
                    ToolTip="Support HMSUPSUNI au pied des poteaux, vis VSZ10070 + écrou VEF10 à la place des goupilles" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- Onglet d'une tour escalier alu (T1, T2…) : DataContext = TourViewModel (projet multi-ouvrages, 28/11/2026). -->
    <DataTemplate x:Key="PanneauTour">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,0,10,10">
          <TextBlock Style="{StaticResource Section}" Text="TOUR ESCALIER À VOLÉES ALU" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Etiquette}" Text="Longueur (m)" />
            <TextBlock Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="2,50 (volées de 2,50 m)" />
            <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Largeur (m)" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static vm:TourViewModel.Largeurs}" SelectedItem="{app:Liaison Largeur}" ItemStringFormat="0.00"
                      ToolTip="1,50 m : volées de 0,65 m ; 2,00 m : volées larges de 0,88 m" />
            <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Paliers" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static vm:TourViewModel.Configurations}" DisplayMemberPath="Value" SelectedValuePath="Key"
                      SelectedValue="{app:Liaison Configuration}" />
            <TextBlock Grid.Row="3" Style="{StaticResource Etiquette}" Text="Dernier palier (m)" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{app:Liaison Hauteur, StringFormat=0.00}"
                     ToolTip="Multiple de 0,50 m ; en xx,50 m la tour part d'un plancher de départ à 0,50 m" />
            <TextBlock Grid.Row="4" Style="{StaticResource Etiquette}" Text="Entrée au sol" />
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static vm:TourViewModel.Entrees}" DisplayMemberPath="Value" SelectedValuePath="Key"
                      SelectedValue="{app:Liaison Entree}" ToolTip="Bout du pied de la première volée" />
          </Grid>
          <TextBlock Text="{app:Liaison ErreurHauteur}" Foreground="#C62828" TextWrapping="Wrap" FontSize="12" Margin="0,2"
                     Visibility="{app:Liaison HauteurIncorrecte, Converter={StaticResource VisibleSi}}" />
          <CheckBox Content="Départ poteaux 3 m" IsChecked="{app:Liaison Depart3m}" />
          <Border Background="#F3F4F6" CornerRadius="6" Padding="8" Margin="0,6,0,0">
            <TextBlock Text="{app:Liaison Resume}" TextWrapping="Wrap" FontSize="12" />
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="POSITION" />
          <CheckBox Content="Accolée à une face de la façade" IsChecked="{app:Liaison Accolee}"
                    ToolTip="La tour garde ses poteaux, côté bâtiment contre la file extérieure de la face, reliée par tubes et colliers ; le garde-corps de la façade s'ouvre devant ses sorties côté bâtiment" />
          <Grid Visibility="{app:Liaison Accolee, Converter={StaticResource VisibleSi}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Etiquette}" Text="Face" />
            <ComboBox Grid.Column="1" Margin="0,2" ItemsSource="{app:Liaison FacesPossibles}" SelectedItem="{app:Liaison FaceAccolee}" />
            <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Début de la tour depuis le début de la face (m)" TextWrapping="Wrap" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{app:Liaison Abscisse, StringFormat=0.00}" />
            <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Écart avec la file extérieure (m)" TextWrapping="Wrap" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{app:Liaison Ecart, StringFormat=0.00}" />
            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Sorties côté façade aux planchers communs" Command="{app:Liaison SortiesCoteFacade}"
                    HorizontalAlignment="Left" Padding="10,4" Margin="0,6,0,0" />
          </Grid>
          <Grid Visibility="{app:Liaison Seule, Converter={StaticResource VisibleSi}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Etiquette}" Text="Position X (m)" />
            <TextBox Grid.Column="1" Margin="0,2" Text="{app:Liaison PositionX, StringFormat=0.00}" ToolTip="Coin bout gauche, côté bâtiment, dans le repère du projet (S1 part de X = 0)" />
            <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Position Y (m)" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{app:Liaison PositionY, StringFormat=0.00}" />
            <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Rotation (°)" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static vm:TourViewModel.Angles}" SelectedItem="{app:Liaison Angle}" ItemStringFormat="0" />
            <TextBlock Grid.Row="3" Style="{StaticResource Etiquette}" Text="Stabilité" />
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static vm:TourViewModel.Stabilites}" DisplayMemberPath="Value" SelectedValuePath="Key"
                      SelectedValue="{app:Liaison Stabilite}" />
            <TextBlock Grid.Row="4" Style="{StaticResource Etiquette}" Text="Distance au bâtiment (m)" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Text="{app:Liaison DistanceBatiment, StringFormat=0.00}" ToolTip="Entre le côté bâtiment de la tour et le mur : longueur des tubes d'amarrage" />
            <TextBlock Grid.Row="5" Style="{StaticResource Etiquette}" Text="Hauteur de stabilisation (m)" Visibility="{app:Liaison Stabilisee, Converter={StaticResource VisibleSi}}" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" Text="{app:Liaison HauteurStabilisation, StringFormat=0.00}" Visibility="{app:Liaison Stabilisee, Converter={StaticResource VisibleSi}}"
                     ToolTip="Structure de base côté extérieur, vers le bout opposé à l'entrée : modules de 2,50 m, diagonales verticales et horizontales (autostable &lt; 85 km/h)" />
          </Grid>

          <TextBlock Style="{StaticResource Section}" Text="PALIERS ET SORTIES" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Discret}" Margin="0,0,0,4"
                     Text="Côtés vus de l'extérieur, face au bâtiment (ou à la façade) : côté bâtiment au fond, côté extérieur devant, bouts gauche et droit. Ouverture de 0,50 ou 1,00 m sur un grand côté, au bout du palier ; sur un bout, seulement là où arrive la volée. Sortie acrotère : ouverture de 1,00 m, pont de franchissement et structure de sortie posée sur le toit, 1,00 m sous le palier. Clic droit sur une lisse de la tour dans le dessin : ouvrir ou fermer le côté, ajouter ou retirer une sortie acrotère." />
          <DataGrid ItemsSource="{app:Liaison Paliers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" SelectionMode="Single" MaxHeight="360" FrozenColumnCount="1"
                    HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Palier (m)" Binding="{app:Liaison Hauteur, StringFormat=0.00}" IsReadOnly="True" Width="70" />
              <DataGridTemplateColumn Header="Côté bâtiment" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsChecked="{app:Liaison SortieA, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0" />
                      <ComboBox ItemsSource="{x:Static vm:TourViewModel.LargeursOuverture}" SelectedItem="{app:Liaison LargeurA, UpdateSourceTrigger=PropertyChanged}"
                                ItemStringFormat="0.00" Width="56" IsEnabled="{app:Liaison SortieA}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Côté extérieur" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsChecked="{app:Liaison SortieC, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0" />
                      <ComboBox ItemsSource="{x:Static vm:TourViewModel.LargeursOuverture}" SelectedItem="{app:Liaison LargeurC, UpdateSourceTrigger=PropertyChanged}"
                                ItemStringFormat="0.00" Width="56" IsEnabled="{app:Liaison SortieC}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Bout d'arrivée" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{app:Liaison SortieBout, UpdateSourceTrigger=PropertyChanged}" Content="{app:Liaison TexteBout}" VerticalAlignment="Center" Margin="4,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Acrotère" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <ComboBox ItemsSource="{x:Static vm:PalierTour.ChoixAcrotere}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                SelectedValue="{app:Liaison Acrotere, UpdateSourceTrigger=PropertyChanged}" Width="74" Margin="2,0"
                                ToolTip="Sortie acrotère : ouverture de 1,00 m, pont de franchissement, structure de sortie sur le toit (1,00 m sous le palier)" />
                      <ComboBox ItemsSource="{x:Static vm:PalierTour.LongueursPont}" SelectedItem="{app:Liaison LongueurPont, UpdateSourceTrigger=PropertyChanged}"
                                ItemStringFormat="0.00" Width="56" Margin="2,0" IsEnabled="{app:Liaison AvecAcrotere}" ToolTip="Longueur du pont de franchissement (m)" />
                      <CheckBox IsChecked="{app:Liaison AcrotereTournee, UpdateSourceTrigger=PropertyChanged}" Content="Tournée" VerticalAlignment="Center" Margin="4,0"
                                IsEnabled="{app:Liaison AvecAcrotere}" ToolTip="Structure de sortie tournée à 90° le long du côté (sinon droite, dans le prolongement du pont)" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <Menu x:Name="MenuPrincipal" DockPanel.Dock="Top">
      <MenuItem Header="_Fichier">
        <MenuItem Header="_Nouveau" Click="Nouveau_Click" />
        <MenuItem Header="_Ouvrir…" Click="Ouvrir_Click" />
        <MenuItem Header="_Enregistrer" Click="Enregistrer_Click" />
        <MenuItem Header="Enregistrer _sous…" Click="EnregistrerSous_Click" />
        <Separator />
        <MenuItem Header="E_xporter le modèle…" Click="ExporterModele_Click" ToolTip="Modèle 3D en DWG, DXF, PDF… (formats de VectorDraw)" />
        <Separator />
        <MenuItem Header="_Quitter" Click="Quitter_Click" />
      </MenuItem>
      <MenuItem Header="_Affichage">
        <MenuItem Header="Zoom tout" Click="ZoomTout_Click" />
        <Separator />
        <MenuItem Header="Iso" Tag="Iso" Click="Vue_Click" />
        <MenuItem Header="Façade" Tag="Facade" Click="Vue_Click" />
        <MenuItem Header="Dessus" Tag="Dessus" Click="Vue_Click" />
        <MenuItem Header="Côté gauche" Tag="CoteGauche" Click="Vue_Click" />
        <MenuItem Header="Côté droit" Tag="CoteDroit" Click="Vue_Click" />
      </MenuItem>
      <MenuItem Header="_Outils">
        <MenuItem Header="Paramètres par _défaut…" Click="ParametresParDefaut_Click" />
      </MenuItem>
      <MenuItem Header="_Aide">
        <MenuItem Header="_Guide utilisateur" Click="Guide_Click" />
        <MenuItem Header="Rechercher les _mises à jour…" Click="MisesAJour_Click" />
        <MenuItem Header="_Droits d'utilisation…" Click="DroitsUtilisation_Click" />
        <MenuItem Header="À _propos de MultiDEC…" Click="APropos_Click" />
      </MenuItem>
    </Menu>

    <!-- Ruban -->
    <Border x:Name="Ruban" DockPanel.Dock="Top" Background="#F8F9FA" BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Margin="4,4,4,2">
        <Border Style="{StaticResource GroupeRuban}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BoutonRuban}" Click="Nouveau_Click" ToolTip="Nouveau projet">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE8A5;" /><TextBlock Text="Nouveau" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" Click="Ouvrir_Click" ToolTip="Ouvrir un projet .mdc3">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE8E5;" /><TextBlock Text="Ouvrir" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" Click="Enregistrer_Click" ToolTip="Enregistrer le projet">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE74E;" /><TextBlock Text="Enregistrer" /></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource TitreGroupe}" Text="Projet" />
          </StackPanel>
        </Border>
        <!-- Ouvrages du projet (multi-ouvrages, Laurent 28/11/2026) : façade, tours escalier alu ; tour limon et SafeAccess à venir. -->
        <Border Style="{StaticResource GroupeRuban}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BoutonAjouterFacade" Style="{StaticResource BoutonRuban}" Click="AjouterFacade_Click"
                      ToolTip="Ajoute l'échafaudage de façade au projet (onglets S1…)">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE80A;" /><TextBlock Text="+ Façade" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" Click="AjouterTour_Click" IsEnabled="{app:Liaison PeutAjouterTour}"
                      ToolTip="Ajoute une tour escalier à volées aluminium (onglet T1, T2…), seule ou accolée à une face">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE8B7;" /><TextBlock Text="+ Tour escalier alu" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" IsEnabled="False" ToolTip="À venir : tour escalier à volées limon">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE8B7;" /><TextBlock Text="+ Tour limon" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" Click="SupprimerOuvrage_Click"
                      ToolTip="Retire du projet l'ouvrage de l'onglet ouvert (la tour, ou la façade s'il reste une tour)">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE74D;" /><TextBlock Text="Supprimer" /></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource TitreGroupe}" Text="Ouvrages" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource GroupeRuban}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BoutonRuban}" Command="{app:Liaison Proposer}" ToolTip="Recalcule les grilles de la face active depuis ses dimensions">
                <StackPanel>
                  <TextBlock Text="&#xE82F;">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Picto}">
                        <Setter Property="Foreground" Value="#2E7D32" />
                        <Style.Triggers>
                          <DataTrigger Binding="{app:Liaison FaceActiveAValider}" Value="True">
                            <Setter Property="Foreground" Value="#C62828" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="Valider la structure" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" Click="Dessiner_Click" ToolTip="Générer et dessiner toute la structure">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE768;" /><TextBlock Text="Dessiner" FontWeight="SemiBold" /></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource TitreGroupe}" Text="Structure" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource GroupeRuban}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BoutonRuban}" Click="ZoomTout_Click" ToolTip="Afficher tout le modèle, centré">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE71E;" /><TextBlock Text="Zoom tout" /></StackPanel>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Button Content="Iso" Tag="Iso" Click="Vue_Click" Padding="8,2" Margin="1" />
                  <Button Content="Façade" Tag="Facade" Click="Vue_Click" Padding="8,2" Margin="1" />
                  <Button Content="Dessus" Tag="Dessus" Click="Vue_Click" Padding="8,2" Margin="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Côté gauche" Tag="CoteGauche" Click="Vue_Click" Padding="8,2" Margin="1" />
                  <Button Content="Côté droit" Tag="CoteDroit" Click="Vue_Click" Padding="8,2" Margin="1" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource TitreGroupe}" Text="Vue" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource GroupeRuban}">
          <StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="4,2">
              <ComboBox x:Name="ChoixRendu" Width="150" SelectedIndex="2" SelectionChanged="Rendu_SelectionChanged">
                <ComboBoxItem Content="Filaire" Tag="Filaire" />
                <ComboBoxItem Content="Lignes cachées" Tag="LignesCachees" />
                <ComboBoxItem Content="Ombré" Tag="Ombre" />
                <ComboBoxItem Content="Ombré + arêtes" Tag="OmbreAretes" />
                <ComboBoxItem Content="Réaliste" Tag="Realiste" />
              </ComboBox>
              <CheckBox x:Name="CaseAxes" Content="Axes filaires" IsChecked="True" IsEnabled="False" Margin="0,4,0,0"
                        ToolTip="Les axes filaires sont toujours affichés" />
              <CheckBox Content="Dessiner façade" IsChecked="{app:Liaison DessinerFacade}" Click="Facade_Click"
                        ToolTip="Représente le mur du bâtiment à la distance à la façade de chaque face" />
            </StackPanel>
            <TextBlock Style="{StaticResource TitreGroupe}" Text="Affichage" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource GroupeRuban}" BorderThickness="0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BoutonRuban}" Click="MiseEnPlan_Click"
                      ToolTip="Plans A3 cotés (dessus, élévations, profils, isos, détails) en PDF, affichés dans le viewer intégré">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE8A1;" /><TextBlock Text="Mise en plan" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" Click="ListeMateriel_Click"
                      ToolTip="Liste du matériel en PDF A4 (décompte, totaux et alertes), affichée dans le viewer intégré">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE749;" /><TextBlock Text="Liste matériel" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BoutonRuban}" IsEnabled="False" ToolTip="À venir : devis">
                <StackPanel><TextBlock Style="{StaticResource Picto}" Text="&#xE8EF;" /><TextBlock Text="Devis" /></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource TitreGroupe}" Text="Sortie" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock Text="{app:Liaison Resume}" />
      <Separator />
      <TextBlock x:Name="TexteBibliotheque" />
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="5" />
        <RowDefinition Height="320" MinHeight="120" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="370" MinWidth="280" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Paramétrage : Général puis une face par onglet (ajoutés par le code selon la forme). -->
      <TabControl x:Name="Onglets" Grid.Row="0" Grid.Column="0" Margin="6,6,0,0" SelectionChanged="Onglets_SelectionChanged">
        <TabItem Header="Général">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0,10,10">
              <TextBlock Style="{StaticResource Section}" Text="PROJET" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Etiquette}" Text="Chantier" />
                <TextBox Grid.Column="1" Margin="0,2" Text="{app:Liaison Projet.Chantier}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Client" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{app:Liaison Projet.Client}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Référence étude" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{app:Liaison Projet.ReferenceEtude}" />
              </Grid>

              <TextBlock Style="{StaticResource Section}" Text="MATÉRIEL" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Etiquette}" Text="Modèle" />
                <ComboBox Grid.Column="1" Margin="0,2" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixModeles}"
                          SelectedItem="{app:Liaison General.Modele}" SelectionChanged="Modele_SelectionChanged" />
                <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Plateaux" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{app:Liaison ChoixGammes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{app:Liaison General.Plateaux}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Socles" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{app:Liaison ChoixSocles}" DisplayMemberPath="Libelle" SelectedValuePath="Reference"
                          SelectedValue="{app:Liaison General.Socle}" />
              </Grid>

              <TextBlock Style="{StaticResource Section}" Text="FORME DE LA STRUCTURE" />
              <UniformGrid Columns="5">
                <RadioButton Style="{StaticResource BoutonForme}" GroupName="Forme" IsChecked="{app:Liaison Forme, Converter={StaticResource Egal}, ConverterParameter=Droite}">
                  <StackPanel>
                    <Path Data="M2,18 H38 V25 H2 Z" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="40" Height="28" HorizontalAlignment="Center" />
                    <TextBlock Text="Droite" FontSize="12" HorizontalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource BoutonForme}" GroupName="Forme" IsChecked="{app:Liaison Forme, Converter={StaticResource Egal}, ConverterParameter=EnL}">
                  <StackPanel>
                    <Path Data="M2,18 H31 V2 H38 V25 H2 Z" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="40" Height="28" HorizontalAlignment="Center" />
                    <TextBlock Text="En L" FontSize="12" HorizontalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource BoutonForme}" GroupName="Forme" IsChecked="{app:Liaison Forme, Converter={StaticResource Egal}, ConverterParameter=EnU}">
                  <StackPanel>
                    <Path Data="M2,2 H9 V18 H31 V2 H38 V25 H2 Z" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="40" Height="28" HorizontalAlignment="Center" />
                    <TextBlock Text="En U" FontSize="12" HorizontalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource BoutonForme}" GroupName="Forme" IsChecked="{app:Liaison Forme, Converter={StaticResource Egal}, ConverterParameter=Fermee}">
                  <StackPanel>
                    <Path Data="M2,2 H38 V25 H2 Z M9,9 H31 V18 H9 Z" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="40" Height="28" HorizontalAlignment="Center" />
                    <TextBlock Text="Fermée" FontSize="12" HorizontalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource BoutonForme}" GroupName="Forme" IsChecked="{app:Liaison Forme, Converter={StaticResource Egal}, ConverterParameter=Volumique}">
                  <StackPanel>
                    <Path Data="M2,2 H38 V25 H2 Z M2,11 H38 M2,18 H38" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="40" Height="28" HorizontalAlignment="Center" />
                    <TextBlock Text="Volumique" FontSize="12" HorizontalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
              <TextBlock Text="La forme crée les onglets S1 à S4. À partir de S2, la 1re maille est le carré d'angle qui raccorde la face à la précédente. Volumique : modules M1 (contre la façade), M2, M3… côte à côte en profondeur, longueur et largeur propres à chaque module (largeur jusqu'à 3,00 m), accès proposés sur M1."
                         TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Discret}" Margin="0,6,0,0" />
              <CheckBox Content="Inverser la structure (bâtiment dans l'angle rentrant)" IsChecked="{app:Liaison Inversee}" Margin="0,6,0,0"
                        Visibility="{app:Liaison InversionPossible, Converter={StaticResource VisibleSi}}"
                        ToolTip="Le bâtiment est de l'autre côté de l'échafaudage : les faces tournent dans l'autre sens, côté mur et côté extérieur sont permutés (garde-corps, escaliers, appro… passent de l'autre côté)" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                          Visibility="{app:Liaison EstVolumique, Converter={StaticResource VisibleSi}}">
                <TextBlock Text="Modules" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="60" ItemsSource="{x:Static vm:FacadeViewModel.ChoixModules}" SelectedItem="{app:Liaison NombreModules}" />
                <Button Content="+ Module" Command="{app:Liaison AjouterModule}" Padding="8,2" Margin="6,0,0,0"
                        ToolTip="Ajoute un module derrière le dernier (mêmes mailles que M1, sans accès)" />
                <CheckBox Content="Planchers en damier" IsChecked="{app:Liaison PlanchersDamier}" VerticalAlignment="Center" Margin="16,0,0,0"
                          ToolTip="Plateaux orientés une maille sur deux selon X, la suivante selon Y (sur lisses renforcées dès 1,50 m), en décalé d'un module à l'autre" />
              </StackPanel>

              <TextBlock Style="{StaticResource Section}" Text="GARDE-CORPS ET PLINTHES" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Text="Garde-corps" FontSize="12" Foreground="{StaticResource Discret}" />
                <TextBlock Grid.Column="2" Text="Plinthe" FontSize="12" Foreground="{StaticResource Discret}" Margin="4,0,0,0" />
                <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Extérieur (rue)" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixSecurites}" SelectedItem="{app:Liaison SecuriteExterieure}" />
                <ComboBox Grid.Row="1" Grid.Column="2" Margin="4,2,0,2" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixPlinthes}" SelectedItem="{app:Liaison PlintheExterieure}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Intérieur (mur)" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixSecurites}" SelectedItem="{app:Liaison SecuriteInterieure}" />
                <ComboBox Grid.Row="2" Grid.Column="2" Margin="4,2,0,2" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixPlinthes}" SelectedItem="{app:Liaison PlintheInterieure}" />
                <TextBlock Grid.Row="3" Style="{StaticResource Etiquette}" Text="Abouts" />
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixSecurites}" SelectedItem="{app:Liaison SecuriteAbouts}" />
                <ComboBox Grid.Row="3" Grid.Column="2" Margin="4,2,0,2" Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison ChoixPlinthes}" SelectedItem="{app:Liaison PlintheAbouts}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox Content="About gauche" IsChecked="{app:Liaison General.AboutGauche}" Margin="0,3,16,3" />
                <CheckBox Content="About droit" IsChecked="{app:Liaison General.AboutDroit}" />
              </StackPanel>
              <TextBlock Text="En L, en U ou fermée, pas d'about aux raccords entre faces." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Discret}" />

              <TextBlock Style="{StaticResource Section}" Text="AMARRAGES" />
              <CheckBox Content="Échafaudage bâché" IsChecked="{app:Liaison General.Bache}" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Etiquette}" Text="1er amarrage (m)" />
                <TextBox Grid.Column="2" Margin="0,2" Text="{app:Liaison General.HauteurPremierAmarrage, StringFormat=0.00}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Etiquette}" Text="Extrémités (m)" />
                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,2" Text="{app:Liaison General.EspacementAmarrageExtremite, StringFormat=0.##}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Etiquette}" Text="Courant, non bâché / bâché (m)" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,4,2" Text="{app:Liaison General.EspacementAmarrageCourant, StringFormat=0.##}" />
                <TextBox Grid.Row="2" Grid.Column="2" Margin="0,2" Text="{app:Liaison General.EspacementAmarrageCourantBache, StringFormat=0.##}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />

      <!-- Dessin 3D : toute la structure, la face active en couleur. -->
      <Border Grid.Row="0" Grid.Column="2" Margin="0,6,6,0" BorderBrush="{StaticResource Bordure}" BorderThickness="1">
        <wfi:WindowsFormsHost x:Name="HoteVectorDraw" />
      </Border>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" />

      <!-- Grilles de la face active, décompte, amarrages, alertes. -->
      <TabControl x:Name="OngletsBas" Grid.Row="2" Grid.ColumnSpan="3" Margin="6,0,6,6">
        <TabItem x:Name="OngletGrilles">
          <TabItem.Header>
            <Border Background="{app:Liaison CouleurFaceActive}" CornerRadius="2" Padding="6,1" Margin="-4,-1">
              <TextBlock Text="{app:Liaison TitreGrilles}" />
            </Border>
          </TabItem.Header>
          <Grid Margin="0" Background="{app:Liaison CouleurFaceActive}">
            <Grid Margin="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" MinWidth="380" />
              </Grid.ColumnDefinitions>

              <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Ajouter" Click="AjouterMaille_Click" Padding="10,3" Margin="2,0" ToolTip="Ajoute une maille après la maille sélectionnée (à la fin sinon)" />
                    <Button Content="Insérer avant" Click="InsererMaille_Click" Padding="10,3" Margin="2,0" />
                    <Button Content="Supprimer" Click="SupprimerMaille_Click" Padding="10,3" Margin="2,0" />
                  </StackPanel>
                  <TextBlock Text="Mailles (de gauche à droite)" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <!-- Colonnes « ConXm » ajoutées par le code, une par niveau avec console. -->
                <DataGrid x:Name="GrilleMailles" ItemsSource="{app:Liaison Mailles}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                          HeadersVisibility="All" RowHeaderWidth="32" SelectionMode="Single" LoadingRow="GrilleMailles_LoadingRow">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Longueur" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison Longueur, StringFormat=0.00}" Margin="2,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <!-- Maille d'accès : 1,50 m au moins (Laurent, 25/11/2026). -->
                          <ComboBox ItemsSource="{app:Liaison Type, Converter={StaticResource LongueursSelonType}}"
                                    SelectedItem="{app:Liaison Longueur, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="0.00" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Type" Width="160">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison Type, Converter={StaticResource Libelle}}" Margin="2,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison DataContext.ChoixTypesMaille, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{app:Liaison Type, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Diago" Width="Auto">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{app:Liaison Diagonale, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                    ToolTip="Diagonales verticales sur toute la hauteur de la maille" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Départ" Width="62">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison HauteurDepart, StringFormat=0.00}" Margin="2,0"
                                     ToolTip="Hauteur du sol sous la maille (sol en pente) : la maille part de cette hauteur, par pas de 0,50 m" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{app:Liaison DataContext.ChoixHauteursDepart, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{app:Liaison HauteurDepart, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="0.00" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ht max" Width="70">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Margin="2,0" ToolTip="Dernier plancher de la maille : à un multiple de 2 m du dernier plancher de la face, plus haut (planchers tous les 2 m) ou plus bas">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource HauteurMax}">
                                <Binding Path="EcartHauteur" />
                                <Binding Path="DataContext.HauteurDernierPlancher" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{app:Liaison DataContext.ChoixHauteursMaille, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedValuePath="Key" DisplayMemberPath="Value"
                                    SelectedValue="{app:Liaison EcartHauteur, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Stab." Width="60">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison Stabilisation, Converter={StaticResource CoteOptionnelle}}" Margin="2,0"
                                     ToolTip="Stabilisation côté extérieur : file de poteaux à cette distance, lisses et diagonales jusqu'à 2 m sous le dernier plancher" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{app:Liaison DataContext.ChoixStabilisation, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{app:Liaison Stabilisation, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{app:Liaison Converter={StaticResource CoteOptionnelle}}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ColonneLest" Header="Lest" Width="Auto" Visibility="Collapsed">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{app:Liaison Lest, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                    IsEnabled="{app:Liaison Stabilisation, Converter={StaticResource PositifEnBooleen}}"
                                    ToolTip="Platelage à 0,50 m dans la stabilisation (entre la file extérieure et la file de stabilisation) pour poser du lest" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Poutre" Width="70">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison Poutre, Converter={StaticResource CoteOptionnelle}}" Margin="2,0"
                                     ToolTip="Poutre de franchissement sous ce niveau, sur cette maille et la suivante : la file entre les deux est supprimée dessous" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{app:Liaison DataContext.HauteursPoutre, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{app:Liaison Poutre, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{app:Liaison Converter={StaticResource CoteOptionnelle}}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Prof. recette" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison ProfondeurRecette, StringFormat=0.00}" Margin="2,0" ToolTip="Profondeur de la recette côté extérieur">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{app:Liaison Type, Converter={StaticResource Egal}, ConverterParameter=Recette}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{app:Liaison DataContext.ChoixProfondeursRecette, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{app:Liaison ProfondeurRecette, UpdateSourceTrigger=PropertyChanged}"
                                    ItemStringFormat="0.00" IsEnabled="{app:Liaison Type, Converter={StaticResource Egal}, ConverterParameter=Recette}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Jonction" Binding="{app:Liaison Jonction}" IsReadOnly="True" Width="Auto">
                      <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                          <Setter Property="Background" Value="#F6F7F9" />
                          <Setter Property="Foreground" Value="#57606A" />
                          <Setter Property="ToolTip" Value="Carré d'angle : raccord avec cette face (rempli d'après la forme)" />
                        </Style>
                      </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>

              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Niveaux de plancher" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{app:Liaison Niveaux}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Niveau (m)" Binding="{app:Liaison Hauteur, StringFormat=0.00}" Width="80" />
                    <DataGridTemplateColumn Header="Type" Width="150">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison Type, Converter={StaticResource Libelle}}" Margin="2,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox Style="{StaticResource ListeLibelles}" ItemsSource="{app:Liaison DataContext.ChoixTypesPlancher, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{app:Liaison Type, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Console" Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{app:Liaison Console}" Margin="2,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{app:Liaison DataContext.Consoles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{app:Liaison Console, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pare-grav." Width="Auto">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{app:Liaison PareGravois, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                    ToolTip="Pare-gravois à ce niveau sur toute la longueur de la face (consoles, tôles, lisses)" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Diago H" Width="Auto">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{app:Liaison DiagoH, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                    ToolTip="Diagonales horizontales à ce niveau dans les mailles de travail, sens alterné automatiquement" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ColonneAppro" Header="Appro" Width="Auto" Visibility="Collapsed">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{app:Liaison Appro, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                    ToolTip="Niveau desservi par les modules d'approvisionnement" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ColonneRecette" Header="Recette" Width="Auto" Visibility="Collapsed">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{app:Liaison Recette, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                    ToolTip="Niveau desservi par les recettes (plancher et garde-corps)" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Décompte">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4">
              <TextBlock Text="Ouvrage" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Width="190" Margin="0,0,16,0" ItemsSource="{app:Liaison ChoixOuvragesDecompte}" SelectedValuePath="Key" DisplayMemberPath="Value"
                        SelectedValue="{app:Liaison OuvrageDecompte}"
                        ToolTip="Décompte de tout le projet, de la façade ou d'une tour (quantités calculées, sans les modifications faites à la main)" />
              <TextBlock Text="Références affichées" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Width="240" ItemsSource="{x:Static vm:FacadeViewModel.ChoixReferences}" SelectedValuePath="Key" DisplayMemberPath="Value"
                        SelectedValue="{app:Liaison ReferencesAffichees}"
                        ToolTip="Travail en références client : le décompte affiche les références du client (LV Tec intégré, ou fichier de correspondance des Paramètres par défaut)" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,6,4" IsEnabled="{app:Liaison DecompteModifiable}">
              <TextBlock Text="Ajouter la référence" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="SaisieReference" Width="150" VerticalContentAlignment="Center" KeyDown="SaisieDecompte_KeyDown"
                       ToolTip="Référence RETOTUB ou référence client : désignation, poids et famille sont repris de multidec.bib" />
              <TextBlock Text="Quantité" VerticalAlignment="Center" Margin="10,0,6,0" />
              <TextBox x:Name="SaisieQuantite" Width="50" Text="1" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                       KeyDown="SaisieDecompte_KeyDown" />
              <Button Content="Ajouter" Padding="10,2" Margin="8,0,0,0" Click="AjouterReference_Click"
                      ToolTip="Ajoute la référence au décompte (repérée par un astérisque dans la liste du matériel)" />
              <Button Content="Rétablir la ligne" Padding="10,2" Margin="16,0,0,0" Click="RetablirLigne_Click"
                      ToolTip="Ligne sélectionnée : remet la quantité calculée, ou retire la référence ajoutée" />
              <Button Content="Tout rétablir" Padding="10,2" Margin="6,0,0,0" Click="RetablirDecompte_Click" IsEnabled="{app:Liaison DecompteCorrige}"
                      ToolTip="Retire toutes les modifications faites à la main dans le décompte" />
              <TextBlock Text="Double-cliquez une quantité pour la modifier." Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="6,4" TextWrapping="Wrap" FontWeight="SemiBold" Text="{app:Liaison ResumeDecompte}" />
            <DataGrid x:Name="GrilleDecompte" ItemsSource="{app:Liaison Decompte}" AutoGenerateColumns="False" IsReadOnly="{app:Liaison DecompteFiltre}"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" CellEditEnding="GrilleDecompte_CellEditEnding">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <DataTrigger Binding="{app:Liaison Modifiee}" Value="True"><Setter Property="Background" Value="#FFF6E0" /></DataTrigger>
                    <DataTrigger Binding="{app:Liaison Ajoutee}" Value="True"><Setter Property="Background" Value="#E6F0FA" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{app:Liaison Repere}" Width="26" IsReadOnly="True" FontWeight="Bold">
                  <DataGridTextColumn.HeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                      <Setter Property="ToolTip" Value="* : référence ajoutée à la main ; M : quantité modifiée à la main" />
                    </Style>
                  </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Famille" Binding="{app:Liaison FamilleAffichee}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn x:Name="ColonneReference" Header="Référence" Binding="{app:Liaison ReferenceAffichee}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn x:Name="ColonneRefRetotub" Header="Réf. RETOTUB" Binding="{app:Liaison Reference}" Width="150" Visibility="Collapsed" IsReadOnly="True" />
                <DataGridTextColumn Header="Désignation" Binding="{app:Liaison Designation}" Width="*" MinWidth="200" IsReadOnly="True" />
                <DataGridTextColumn x:Name="ColonneQuantite" Header="Quantité" Binding="{app:Liaison Quantite}" Width="70">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Calculée" Binding="{app:Liaison QuantiteCalculee}" Width="70" IsReadOnly="True" Foreground="Gray">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Poids U (kg)" Binding="{app:Liaison PoidsUnitaire, StringFormat=N2}" Width="90" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Poids total (kg)" Binding="{app:Liaison PoidsTotal, StringFormat=N1}" Width="110" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem Header="Amarrages">
          <DataGrid ItemsSource="{app:Liaison ListeAmarrages}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Face" Binding="{app:Liaison NomFace}" Width="60" />
              <DataGridTextColumn Header="File" Binding="{app:Liaison NumeroFile}" Width="60" />
              <DataGridTextColumn Header="Abscisse dans la face (m)" Binding="{app:Liaison X, StringFormat=0.00}" Width="170" />
              <DataGridTextColumn Header="Hauteur (m)" Binding="{app:Liaison Hauteur, StringFormat=0.00}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <TabItem Header="{app:Liaison TitreAlertes}">
          <ListBox ItemsSource="{app:Liaison Alertes}" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
