<Window x:Class="MultiDEC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiDEC.App.ViewModels"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="MultiDEC v3 – Échafaudage de façade" Height="900" Width="1500"
        WindowState="Maximized">
  <Window.DataContext>
    <vm:FacadeViewModel />
  </Window.DataContext>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Fichier">
        <MenuItem Header="_Nouveau" Click="Nouveau_Click" />
        <MenuItem Header="_Ouvrir…" Click="Ouvrir_Click" />
        <MenuItem Header="_Enregistrer" Click="Enregistrer_Click" />
        <MenuItem Header="Enregistrer _sous…" Click="EnregistrerSous_Click" />
        <Separator />
        <MenuItem Header="Bibliothèque de blocs…" Click="Bibliotheque_Click" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock Text="{Binding Resume}" />
      <Separator />
      <TextBlock x:Name="TexteBibliotheque" />
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="330" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Paramètres -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="6">
        <StackPanel>
          <GroupBox Header="Projet">
            <StackPanel>
              <TextBlock Text="Chantier" />
              <TextBox Text="{Binding Projet.Chantier}" />
              <TextBlock Text="Client" />
              <TextBox Text="{Binding Projet.Client}" />
              <TextBlock Text="Référence étude" />
              <TextBox Text="{Binding Projet.ReferenceEtude}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Structure">
            <StackPanel>
              <TextBlock Text="Gamme" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.Modeles}" SelectedItem="{Binding Parametres.Modele}" SelectionChanged="Gamme_SelectionChanged" />
              <TextBlock Text="Largeur de maille (m)" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.LargeursMaille}" SelectedItem="{Binding Parametres.LargeurMaille}" ItemStringFormat="0.00" />
              <TextBlock Text="Longueur de façade souhaitée (m)" />
              <TextBox Text="{Binding Parametres.LongueurTotaleSouhaitee, StringFormat=0.00}" />
              <TextBlock Text="Longueur de maille préférée (m)" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.LongueursMaille}" SelectedItem="{Binding Parametres.LongueurMaillePreferee}" ItemStringFormat="0.00" />
              <TextBlock Text="Nombre d'accès" />
              <TextBox Text="{Binding Parametres.NombreAcces}" />
              <TextBlock Text="Hauteur du dernier plancher (m)" />
              <TextBox Text="{Binding Parametres.HauteurDernierPlancher, StringFormat=0.00}" />
              <TextBlock Text="Distance file intérieure – façade (m)" />
              <TextBox Text="{Binding Parametres.DistanceFacade, StringFormat=0.00}" />
              <CheckBox Content="Départ poteaux 3 m côté extérieur" IsChecked="{Binding Parametres.Depart3mExterieur}" />
              <CheckBox Content="Traverses renforcées" IsChecked="{Binding Parametres.Renforce}" />
              <CheckBox Content="Lisses en pied" IsChecked="{Binding Parametres.LissesEnPied}" />
              <Button Content="Proposer la structure" Command="{Binding Proposer}" Margin="0,6,0,0" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Planchers">
            <StackPanel>
              <TextBlock Text="Plateaux" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.GammesPlateaux}" SelectedItem="{Binding Parametres.Plateaux}" />
              <TextBlock Text="Console par défaut (nouvelles mailles)" />
              <ComboBox ItemsSource="{Binding Consoles}" SelectedItem="{Binding Parametres.ConsoleParDefaut}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Sécurité">
            <StackPanel>
              <TextBlock Text="Extérieure" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.Securites}" SelectedItem="{Binding Parametres.SecuriteExterieure}" />
              <TextBlock Text="Intérieure" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.Securites}" SelectedItem="{Binding Parametres.SecuriteInterieure}" />
              <TextBlock Text="Abouts" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.Securites}" SelectedItem="{Binding Parametres.SecuriteAbouts}" />
              <TextBlock Text="Plinthes extérieures / intérieures / abouts" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.Plinthes}" SelectedItem="{Binding Parametres.PlintheExterieure}" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.Plinthes}" SelectedItem="{Binding Parametres.PlintheInterieure}" />
              <ComboBox ItemsSource="{x:Static vm:FacadeViewModel.Plinthes}" SelectedItem="{Binding Parametres.PlintheAbouts}" />
              <CheckBox Content="About gauche" IsChecked="{Binding Parametres.AboutGauche}" />
              <CheckBox Content="About droit" IsChecked="{Binding Parametres.AboutDroit}" />
              <CheckBox Content="Garde-corps couvreur (1,50 m)" IsChecked="{Binding Parametres.GardeCorpsCouvreur}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Diagonales">
            <StackPanel>
              <CheckBox Content="Diagonales renforcées" IsChecked="{Binding Parametres.DiagonalesRenforcees}" />
              <CheckBox Content="Diagonale dans la 1re maille" IsChecked="{Binding Parametres.DiagonalePremiereMaille}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Amarrages">
            <StackPanel>
              <CheckBox Content="Échafaudage bâché" IsChecked="{Binding Parametres.Bache}" />
              <TextBlock Text="1er amarrage (m)" />
              <TextBox Text="{Binding Parametres.HauteurPremierAmarrage, StringFormat=0.00}" />
              <TextBlock Text="Espacement extrémités (m)" />
              <TextBox Text="{Binding Parametres.EspacementAmarrageExtremite, StringFormat=0.00}" />
              <TextBlock Text="Espacement files courantes, non bâché / bâché (m)" />
              <TextBox Text="{Binding Parametres.EspacementAmarrageCourant, StringFormat=0.00}" />
              <TextBox Text="{Binding Parametres.EspacementAmarrageCourantBache, StringFormat=0.00}" />
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>

      <!-- Grilles éditables -->
      <Grid Grid.Column="1" Margin="0,6,6,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Grille des mailles" Grid.Row="0">
          <DataGrid ItemsSource="{Binding Mailles}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
            <DataGrid.Columns>
              <DataGridComboBoxColumn Header="Longueur" SelectedItemBinding="{Binding Longueur}" ItemsSource="{x:Static vm:FacadeViewModel.LongueursMaille}" Width="80" />
              <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" ItemsSource="{x:Static vm:FacadeViewModel.TypesMaille}" Width="80" />
              <DataGridTemplateColumn Header="Console" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Console}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.Consoles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              SelectedItem="{Binding Console, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>

        <GroupBox Header="Niveaux de plancher" Grid.Row="1">
          <DataGrid ItemsSource="{Binding Niveaux}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Hauteur (m)" Binding="{Binding Hauteur, StringFormat=0.00}" Width="90" />
              <DataGridComboBoxColumn Header="Plancher" SelectedItemBinding="{Binding Type}" ItemsSource="{x:Static vm:FacadeViewModel.TypesPlancher}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>

        <Button Grid.Row="2" Content="Dessiner la façade" Padding="6" Click="Dessiner_Click" FontWeight="Bold" />
      </Grid>

      <!-- Dessin + décompte -->
      <Grid Grid.Column="2" Margin="0,6,6,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="5" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wfi:WindowsFormsHost x:Name="HoteVectorDraw" Grid.Row="0" />

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />

        <TabControl Grid.Row="2">
          <TabItem Header="Décompte">
            <DataGrid ItemsSource="{Binding Decompte}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Famille" Binding="{Binding Famille}" Width="150" />
                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="200" />
                <DataGridTextColumn Header="Quantité" Binding="{Binding Quantite}" Width="80" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Alertes">
            <ListBox ItemsSource="{Binding Alertes}" />
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
