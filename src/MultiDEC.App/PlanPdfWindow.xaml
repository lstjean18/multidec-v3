<Window x:Class="MultiDEC.App.PlanPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Mise en plan" Height="860" Width="1220" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
  <!--
    Viewer intégré de la mise en plan (Laurent, 27/11/2026) : le PDF généré s'affiche avec PDFium (PdfiumViewer),
    sans lecteur PDF à installer. Enregistrer, imprimer, ouvrir dans le lecteur du poste.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="Enregistrer sous…" Click="EnregistrerSous_Click" Padding="12,3" Margin="0,0,6,0" />
          <Button Content="Imprimer…" Click="Imprimer_Click" Padding="12,3" Margin="0,0,6,0" />
          <Button Content="Ouvrir dans le lecteur PDF" Click="OuvrirExterne_Click" Padding="12,3" Margin="0,0,6,0" />
        </StackPanel>
        <TextBlock x:Name="TexteInfo" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#57606A" />
      </DockPanel>
    </Border>
    <wfi:WindowsFormsHost x:Name="Hote" />
  </DockPanel>
</Window>
