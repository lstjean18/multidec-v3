<Window x:Class="MultiDEC.Admin.FenetreMotDePasse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
  <StackPanel Margin="14">
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,8" />
    <PasswordBox x:Name="MotDePasse" Margin="0,0,0,6" />
    <TextBlock x:Name="LibelleConfirmation" Text="Confirmez le mot de passe :" Visibility="Collapsed" />
    <PasswordBox x:Name="Confirmation" Margin="0,4,0,6" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="18,4" />
      <Button Content="Annuler" IsCancel="True" Padding="14,4" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
