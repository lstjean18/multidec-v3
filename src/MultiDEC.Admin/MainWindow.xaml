<Window x:Class="MultiDEC.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiDEC Admin – RETOTUB" Height="720" Width="1080" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Icon="MultiDEC.ico">
  <DockPanel>
    <!-- Journal des opérations (publications, erreurs). -->
    <Expander DockPanel.Dock="Bottom" Header="Journal des opérations" IsExpanded="True" Margin="8,0,8,8">
      <TextBox x:Name="Journal" Height="110" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
               FontFamily="Consolas" FontSize="12" />
    </Expander>

    <TabControl Margin="8">
      <!-- ============================== Licences ============================== -->
      <TabItem Header="Licences">
        <DockPanel Margin="8">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button Content="Nouvelle licence…" Click="Nouvelle_Click" Padding="10,4" Margin="0,0,6,0" />
              <Button Content="Modifier…" Click="Modifier_Click" Padding="10,4" Margin="0,0,6,0" />
              <Button Content="Supprimer" Click="Supprimer_Click" Padding="10,4" Margin="0,0,6,0" />
              <Button Content="Écrire au demandeur…" Click="Ecrire_Click" Padding="10,4" Margin="0,0,6,0" />
              <Button Content="Recharger" Click="Recharger_Click" Padding="10,4" Margin="0,0,6,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" x:Name="BoutonPublierListe" Content="Publier la liste…" Click="PublierListe_Click"
                    Padding="14,4" FontWeight="SemiBold" />
            <TextBox x:Name="Filtre" Margin="12,0" VerticalContentAlignment="Center" TextChanged="Filtre_TextChanged"
                     ToolTip="Rechercher (code, nom, entreprise, e-mail)" />
          </DockPanel>
          <TextBlock x:Name="EtatListe" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource Discret}" TextWrapping="Wrap" />
          <DataGrid x:Name="Grille" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserAddRows="False" HeadersVisibility="Column" MouseDoubleClick="Modifier_Click" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Code du poste" Binding="{Binding Code}" FontFamily="Consolas" Width="170" />
              <DataGridTextColumn Header="Demandeur" Binding="{Binding Demandeur}" Width="*" />
              <DataGridTextColumn Header="Entreprise" Binding="{Binding Entreprise}" Width="*" />
              <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
              <DataGridTextColumn Header="Expiration" Binding="{Binding Expiration, StringFormat=dd/MM/yyyy, TargetNullValue=sans limite}" Width="100" />
              <DataGridTextColumn Header="État" Binding="{Binding Etat}" Width="90" />
              <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ============================== Versions ============================== -->
      <TabItem Header="Versions de MultiDEC">
        <StackPanel Margin="12" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Publie sur le site un installateur déjà construit (publication\Publier-version.ps1 sans -Envoyer, ou artefact de la compilation). MultiDEC propose la mise à jour aux postes dès que la fiche version.json annonce un numéro plus grand que le leur." />
          <TextBlock x:Name="VersionEnLigne" Foreground="{StaticResource Discret}" Margin="0,0,0,12" TextWrapping="Wrap" Text="Version publiée : (non lue)" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Installateur" VerticalAlignment="Center" />
            <TextBox x:Name="CheminInstallateur" Grid.Column="1" Margin="0,3" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Parcourir…" Click="ParcourirInstallateur_Click" Padding="10,2" Margin="6,3,0,3" />
            <TextBlock Grid.Row="1" Text="Numéro de version" VerticalAlignment="Center" />
            <TextBox x:Name="NumeroVersion" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="140" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="2" Text="Libellé" VerticalAlignment="Center" />
            <TextBox x:Name="LibelleVersion" Grid.Row="2" Grid.Column="1" Margin="0,3" ToolTip="ex. v3.0 bêta 2" />
            <TextBlock Grid.Row="3" Text="Nouveautés" Margin="0,6,0,0" />
            <TextBox x:Name="NotesVersion" Grid.Row="3" Grid.Column="1" Margin="0,3" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="InfoInstallateur" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,3" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="140,10,0,0">
            <Button x:Name="BoutonPublierVersion" Content="Publier la version…" Click="PublierVersion_Click" Padding="14,4" FontWeight="SemiBold" />
            <Button Content="Lire la version publiée" Click="LireVersion_Click" Padding="10,4" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <!-- ============================== Paramètres ============================== -->
      <TabItem Header="Paramètres">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Dossier de données" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Discret}" Margin="0,0,0,6"
                       Text="Licences, clé de signature et réglages du serveur. Choisissez un dossier partagé (lecteur réseau) pour travailler à plusieurs sur la même liste, et sauvegardez-le." />
            <DockPanel Margin="0,0,0,16">
              <Button DockPanel.Dock="Right" Content="Changer…" Click="ChangerDossier_Click" Padding="10,2" Margin="6,0,0,0" />
              <TextBox x:Name="DossierDonnees" IsReadOnly="True" />
            </DockPanel>

            <TextBlock Text="Clé de signature" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
            <TextBlock x:Name="EtatCle" TextWrapping="Wrap" Margin="0,0,0,6" />
            <WrapPanel Margin="0,0,0,16">
              <Button x:Name="BoutonCreerCle" Content="Créer la clé…" Click="CreerCle_Click" Padding="10,4" Margin="0,0,6,6" />
              <Button Content="Changer le mot de passe…" Click="ChangerMotDePasseCle_Click" Padding="10,4" Margin="0,0,6,6" />
              <Button Content="Copier la clé publique" Click="CopierClePublique_Click" Padding="10,4" Margin="0,0,6,6" />
              <Button Content="Exporter une sauvegarde…" Click="SauvegarderCle_Click" Padding="10,4" Margin="0,0,6,6" />
            </WrapPanel>

            <TextBlock Text="Serveur de publication (SFTP retotub.com)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Serveur" VerticalAlignment="Center" />
              <TextBox x:Name="SftpHote" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" />
              <TextBox x:Name="SftpPort" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="80" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="2" Text="Utilisateur" VerticalAlignment="Center" />
              <TextBox x:Name="SftpUtilisateur" Grid.Row="2" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="3" Text="Mot de passe (le vôtre)" VerticalAlignment="Center" />
              <PasswordBox x:Name="SftpMotDePasse" Grid.Row="3" Grid.Column="1" Margin="0,3" />
              <TextBlock Grid.Row="4" Text="Dossier distant" VerticalAlignment="Center" />
              <TextBox x:Name="SftpDossier" Grid.Row="4" Grid.Column="1" Margin="0,3" ToolTip="ex. /www/multidec" />
              <TextBlock Grid.Row="5" Text="Adresse web de ce dossier" VerticalAlignment="Center" />
              <TextBox x:Name="SftpAdresse" Grid.Row="5" Grid.Column="1" Margin="0,3" ToolTip="ex. https://www.retotub.com/multidec" />
              <TextBlock Grid.Row="6" Text="Empreinte du serveur" VerticalAlignment="Center" />
              <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3">
                <Button DockPanel.Dock="Right" Content="Lire l'empreinte…" Click="ScannerEmpreinte_Click" Padding="10,2" Margin="6,0,0,0" />
                <TextBox x:Name="SftpEmpreinte" IsReadOnly="True" />
              </DockPanel>
            </Grid>
            <WrapPanel>
              <Button Content="Enregistrer" Click="EnregistrerSftp_Click" Padding="14,4" Margin="0,0,6,6" FontWeight="SemiBold" />
              <Button Content="Tester la connexion" Click="TesterSftp_Click" Padding="10,4" Margin="0,0,6,6" />
              <Button Content="Reprendre la configuration du script" Click="ImporterScript_Click" Padding="10,4" Margin="0,0,6,6"
                      ToolTip="Réglages saisis avec publication\Publier-version.ps1 -ReconfigurerSftp sur ce poste" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
